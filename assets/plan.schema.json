{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wave plan v1.0",
  "$comment": "Structural documentation only. The stdlib CLI also enforces paths, coverage, graph, signatures and aliases. It does not implement a general JSON Schema or YAML validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "title", "goal", "architecture", "max_parallel", "context", "requirements", "decisions", "anti_scope", "interfaces", "tasks", "final_checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "title": {"$ref": "#/$defs/text"},
    "goal": {"$ref": "#/$defs/text"},
    "architecture": {"$ref": "#/$defs/text"},
    "max_parallel": {"type": "integer", "minimum": 1, "maximum": 5, "description": "Required. Use 3 in templates; no silent runtime default."},
    "context": {
      "type": "object", "additionalProperties": false, "required": ["stack", "test_runner"],
      "properties": {"stack": {"$ref": "#/$defs/nonemptyTexts"}, "test_runner": {"$ref": "#/$defs/text"}}
    },
    "requirements": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/namedText"}},
    "decisions": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/namedText"}},
    "anti_scope": {"$ref": "#/$defs/nonemptyTexts"},
    "interfaces": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/interface"}},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/task"}},
    "final_checks": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/finalCommand"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "texts": {"type": "array", "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "nonemptyTexts": {"type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "ids": {"type": "array", "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "file": {"type": "string", "minLength": 1, "maxLength": 20000, "description": "Exact repository-relative POSIX file path; no globs, drives, UNC, backslashes, traversal, .git, Windows reserved names or aliases. Additional rules enforced by CLI."},
    "files": {"type": "array", "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "allowedFiles": {"type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "forbiddenFiles": {"type": "array", "maxItems": 2000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 20000, "description": "Exact file or directory prefix ending in '/'; no glob language."}},
    "namedText": {"type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["command", "timeout_seconds"], "properties": {"command": {"$ref": "#/$defs/text"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60}}, "description": "Opaque instructions. The CLI never runs them or measures their real duration."},
    "finalCommand": {"type": "object", "additionalProperties": false, "required": ["command", "timeout_seconds"], "properties": {"command": {"$ref": "#/$defs/text"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}},
    "interface": {"type": "object", "additionalProperties": false, "required": ["id", "producer", "file", "signature"], "properties": {"id": {"$ref": "#/$defs/id"}, "producer": {"$ref": "#/$defs/id"}, "file": {"$ref": "#/$defs/file"}, "signature": {"$ref": "#/$defs/text"}}},
    "function": {"type": "object", "additionalProperties": false, "required": ["name", "file", "signature", "contains", "does_not_contain"], "properties": {"name": {"$ref": "#/$defs/text"}, "file": {"$ref": "#/$defs/file"}, "signature": {"$ref": "#/$defs/text"}, "contains": {"$ref": "#/$defs/nonemptyTexts"}, "does_not_contain": {"$ref": "#/$defs/nonemptyTexts"}}},
    "consume": {"type": "object", "additionalProperties": false, "required": ["interface", "signature"], "properties": {"interface": {"$ref": "#/$defs/id"}, "signature": {"$ref": "#/$defs/text"}}},
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["red", "red_reason", "green"],
      "properties": {"red": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/command"}]}, "red_reason": {"type": "string", "maxLength": 20000}, "green": {"$ref": "#/$defs/command"}},
      "allOf": [{"if": {"properties": {"red": {"type": "null"}}}, "then": {"properties": {"red_reason": {"$ref": "#/$defs/text"}}}}]
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "depends_on", "profile", "files_allowed", "files_forbidden", "files_read", "resources", "functions", "consumes", "produces", "requirement_ids", "decision_ids", "acceptance", "verification"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "depends_on": {"$ref": "#/$defs/ids"},
        "profile": {"enum": ["fast-mechanical", "standard-implementer", "deep-specialist"]},
        "files_allowed": {"$ref": "#/$defs/allowedFiles"}, "files_forbidden": {"$ref": "#/$defs/forbiddenFiles"}, "files_read": {"$ref": "#/$defs/files"},
        "resources": {"$ref": "#/$defs/texts"}, "functions": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/function"}},
        "consumes": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/consume"}}, "produces": {"$ref": "#/$defs/ids"},
        "requirement_ids": {"$ref": "#/$defs/ids"}, "decision_ids": {"$ref": "#/$defs/ids"},
        "acceptance": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/namedText"}}, "verification": {"$ref": "#/$defs/verification"}
      }
    }
  }
}
